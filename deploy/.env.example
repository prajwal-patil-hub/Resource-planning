# Copy to .env and fill in. `.env` is gitignored — it holds the database
# password, and a password in version control is a password that has leaked.

# The hostname this is served on. Caddy gets a certificate for exactly this.
# Use `localhost` to try the stack locally without a public DNS name.
SITE_ADDRESS=work.example.com

POSTGRES_USER=rp
POSTGRES_DB=resource_planning
# Generate one, do not invent one:  openssl rand -base64 32
POSTGRES_PASSWORD=

# How long without a state change before work counts as stalled (BO-2).
STALE_AFTER_DAYS=3

# Nightly dumps kept for this many days. Thirty is the default because the
# failure this protects against is usually noticed within a month — a table
# quietly emptied by a mistake takes weeks to be spotted, not hours.
BACKUP_KEEP_DAYS=30
